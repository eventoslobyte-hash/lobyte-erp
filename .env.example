# =============================================================================
# BASE DE DATOS (Supabase)
# Project Settings > Database > Connection string:
#   - DATABASE_URL = modo "Transaction pooler" (puerto 6543, agrega
#     ?pgbouncer=true al final). Es la que usa la app en runtime — en
#     Vercel (serverless) es OBLIGATORIO usar el pooler acá.
#   - DIRECT_URL   = conexión directa (puerto 5432, sin pgbouncer). Prisma
#     la usa solo para migraciones (`prisma migrate deploy`).
# Ejemplo real de Supabase (reemplazá host/password por los tuyos):
#   DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# Para desarrollo local con Docker (ver docker-compose.yml) usá en cambio:
#   postgresql://lobyte:lobyte@localhost:5432/lobyte_erp?schema=public
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lobyte_erp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lobyte_erp?schema=public"

# =============================================================================
# APP
# En Vercel, cambiá esto por tu dominio real (ej: https://lobyte-erp.vercel.app
# o tu dominio propio) — se usa en algunos links generados por la app.
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="LOBYTE"
NEXT_PUBLIC_GOOGLE_REVIEWS_URL="https://g.page/r/tu-id-de-google-reviews/review"

# =============================================================================
# GOOGLE CALENDAR API (OAuth2)
# 1. Crear proyecto en https://console.cloud.google.com/
# 2. Habilitar "Google Calendar API"
# 3. Crear credenciales OAuth2.0 (tipo "Web application")
#    Authorized redirect URI: http://localhost:3000/api/google-calendar/callback
# 4. Completar los valores abajo. El REFRESH_TOKEN se obtiene una vez
#    autorizando la app (ver README, sección "Google Calendar") y sirve
#    para que el server pueda crear/editar eventos sin intervención manual.
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# =============================================================================
# NOTIFICACIONES (opcional)
# Webhook de WhatsApp Business API / Twilio, usado por el módulo Post-Evento
# =============================================================================
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
